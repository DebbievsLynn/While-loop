//while loop program
#include <stdio.h>

int main() {
    double balance;
    double withdrawal;

    printf("Enter initial account balance: ");
    scanf("%lf", &balance);


    while (balance > 0) {
        printf("Enter amount to withdraw: ");
        scanf("%lf", &withdrawal);

        if (withdrawal <= balance) {
        balance -=withdrawal;
          printf("Current Balance:");
           scanf("%.2f\n",&balance); 
        } else {
            printf("Insufficient funds.\n");
        }
    }
    printf("Account balance is zero or negative.\n"); 

    return 0;
}

	
